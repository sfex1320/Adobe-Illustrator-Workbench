{
  "name": "aiq-workbench",
  "version": "0.6.39",
  "private": true,
  "description": "Illustrator 效率工作台 —— 模块化 Illustrator 插件（基础阶段工程）",
  "type": "module",
  "workspaces": [
    "apps/panel",
    "packages/contracts",
    "packages/core",
    "packages/host-adapter",
    "packages/ui",
    "packages/fixtures",
    "packages/modules/statistics",
    "packages/modules/selection",
    "packages/modules/text-write",
    "packages/modules/size-align",
    "packages/modules/replace",
    "packages/modules/symmetry",
    "packages/modules/export",
    "packages/modules/preflight",
    "packages/modules/variable-data",
    "packages/modules/artboards",
    "packages/modules/annotation",
    "packages/modules/productivity",
    "packages/modules/style-transfer"
  ],
  "scripts": {
    "dev": "npm run dev -w @aiq/panel",
    "build": "npm run typecheck && npm run build -w @aiq/panel",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:cep": "node scripts/package-cep.mjs",
    "package:windows": "npm run package:cep && node scripts/package-windows.mjs",
    "deploy:local": "npm run build && npm run package:windows && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1",
    "test:glyph:native": "node scripts/test-glyph-native-v0619.mjs",
    "test:export:synthetic": "node scripts/test-export-v064.mjs docs/review/v0616-export-synthetic.json",
    "test:export:native": "node scripts/test-workbench-v0616.mjs && node scripts/verify-workbench-v0616.mjs && python scripts/verify-workbench-v0616.py",
    "test:codec:native": "python scripts/verify-rgb-codec-v0620.py prepare && node scripts/test-rgb-codec-v0620.mjs && python scripts/verify-rgb-codec-v0620.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "jsqr": "1.4.0",
    "puppeteer-core": "^25.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
